# Optional: enables Groq enhancements when running the pipeline locally.
GROQ_API_KEY=

# Required only when PIPELINE_ENABLED=true. Never use the old development
# defaults in a deployed environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated browser origins allowed to call this API in production.
# Example: https://vote-your-way.vercel.app
FRONTEND_URLS=

# Public deployments should serve the committed demo artifacts read-only.
# Set true only on a persistent backend that is intentionally allowed to run
# the long-running pipeline.
PIPELINE_ENABLED=false
